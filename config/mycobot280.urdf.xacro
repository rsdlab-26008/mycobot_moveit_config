<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mycobot280">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import mycobot280 urdf file -->
    <xacro:include filename="$(find moveit_setup_assistant)/mycobot280.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="mycobot280.ros2_control.xacro" />


    <xacro:mycobot280_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
